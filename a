// Variables de colores y fuentes
$primary-color: #2b6cb0;
$accent-color: #319795;
$bg-color: #f7fafc;
$text-color: #2d3748;
$font-stack: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

// Estilos globales
body {
  font-family: $font-stack;
  background-color: $bg-color;
  color: $text-color;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

// Encabezado
.header {
  background-color: $primary-color;
  color: white;
  text-align: center;
  padding: 2rem 1rem;

  &__title {
    margin: 0;
    font-size: 2.2rem;
  }

  &__subtitle {
    margin-top: 0.5rem;
    opacity: 0.9;
  }
}

// Contenedor principal
.container {
  max-width: 800px;
  margin: 2rem auto;
  padding: 0 1rem;
  flex: 1;
}

// Tarjeta
.card {
  background: white;
  border-radius: 8px;
  padding: 1.5rem;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);

  h2 {
    margin-top: 0;
    color: $primary-color;
  }
}

// Botón e interactividad
.btn {
  background-color: $accent-color;
  color: white;
  border: none;
  padding: 0.6rem 1.2rem;
  font-size: 1rem;
  border-radius: 4px;
  cursor: pointer;
  transition: background-color 0.3s ease;

  &:hover {
    background-color: darken($accent-color, 10%);
  }
}

.message-text {
  margin-top: 1rem;
  font-weight: bold;
  color: $primary-color;
}

// Pie de página
.footer {
  text-align: center;
  padding: 1rem;
  background-color: #edf2f7;
  font-size: 0.9rem;
}
